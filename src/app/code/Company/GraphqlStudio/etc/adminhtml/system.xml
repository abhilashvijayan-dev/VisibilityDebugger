<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="company_graphqlstudio"
                 translate="label"
                 type="text"
                 sortOrder="995"
                 showInDefault="1"
                 showInWebsite="1"
                 showInStore="1">
            <label>GraphQL Studio</label>
            <tab>advanced</tab>
            <resource>Company_GraphqlStudio::config</resource>

            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable GraphQL Studio</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When empty, defaults to enabled outside production and disabled in production.</comment>
                </field>
            </group>

            <group id="security" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Security</label>
                <field id="allow_endpoint_override" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Allow Endpoint Override</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="allow_mutations" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Allow Mutations</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="introspection_enabled" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Introspection Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When empty, defaults to enabled in developer mode only.</comment>
                </field>
            </group>

            <group id="execution" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Execution Limits</label>
                <field id="timeout_seconds" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Timeout Seconds</label>
                    <validate>validate-digits</validate>
                </field>
                <field id="max_response_kb" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Max Response Size (KB)</label>
                    <validate>validate-digits</validate>
                </field>
            </group>

            <group id="history" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>History</label>
                <field id="retention_limit_per_user" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Retention Limit Per User</label>
                    <validate>validate-digits</validate>
                </field>
                <field id="retention_ttl_days" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>History TTL (Days)</label>
                    <validate>validate-digits</validate>
                </field>
                <field id="allow_global" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Global History Visibility</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <group id="docs" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Docs</label>
                <field id="cache_ttl" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Introspection Cache TTL (seconds)</label>
                    <validate>validate-digits</validate>
                </field>
            </group>
        </section>
    </system>
</config>
